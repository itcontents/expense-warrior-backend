{
  "name": "expense-warrior-api",
  "version": "0.1.0",
  "private": true,
  "main": "src/server.js",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test",
    "test:postgres": "EW_RUN_POSTGRES_TESTS=1 node --test tests/requestRepository.postgres.test.js tests/approvalPayoutRepository.postgres.test.js tests/paymentLinkRepository.postgres.test.js tests/managerAssignmentRepository.postgres.test.js",
    "db:migrate": "node src/db/migrate.js apply",
    "db:migrate:apply": "node src/db/migrate.js apply",
    "db:migrate:status": "node src/db/migrate.js status",
    "db:migrate:plan": "node src/db/migrate.js plan",
    "db:migrate:verify": "node src/db/migrate.js verify"
  },
  "dependencies": {
    "cloudinary": "^2.11.0",
    "dotenv": "^16.6.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "joi": "^18.2.9",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "sharp": "^0.35.5"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
