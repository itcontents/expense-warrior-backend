# Expense Warrior standalone API and dedicated database
NODE_ENV=development
PORT=3100
# Production requires exact HTTPS origins for the Expense Warrior browser app.
# Development defaults allow localhost and the current LAN preview on port 5175.
EXPENSE_WARRIOR_BROWSER_ORIGINS=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=expense_warrior
# Use a non-superuser runtime role scoped to application tables; never use postgres here.
DB_USER=
DB_PASSWORD=
DB_SSL_MODE=disable
CONFIRM_EXPENSE_WARRIOR_MIGRATIONS=

# ITC integration endpoints and credentials (never reuse the ITC database user)
ITC_API_BASE_URL=http://127.0.0.1:3000/api/v1
ITC_IDENTITY_TIMEOUT_MS=5000
ITC_FINANCE_TIMEOUT_MS=10000
# Use the same key ID and base64 secret configured in ITC's EXPENSE_WARRIOR_SERVICE_KEYS_JSON.
# Generate a new secret with: openssl rand -base64 32. Keep this value in the local .env only.
ITC_SERVICE_CLIENT_ID=
ITC_SERVICE_CLIENT_SECRET=

# Authenticated private evidence assets; .env contains local values only
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP (only needed if Expense Warrior sends its own notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=

# PawaPay V1; signing is mandatory for financial operations
PAWAPAY_API_TOKEN=
# Exact matching account identity from ITC's payment provider configuration.
# Required before enabling payment-link collections; never use an arbitrary UUID.
ITC_PAWAPAY_PROVIDER_ACCOUNT_ID=
ITC_PAWAPAY_PROVIDER_ACCOUNT_VERSION=
PAWAPAY_BASE_URL=https://api.sandbox.pawapay.io
PAWAPAY_DEPOSITS_CALLBACK_URL=
PAWAPAY_PAYOUTS_CALLBACK_URL=
PAWAPAY_REFUNDS_CALLBACK_URL=
PAWAPAY_SIGNATURE_ENABLED=true
# Set true only after the PawaPay account is configured to accept signed financial requests only.
PAWAPAY_SIGNED_REQUESTS_ONLY_CONFIRMED=false
PAWAPAY_COLLECTIONS_ENABLED=false
PAWAPAY_PAYOUTS_ENABLED=false
# Keep callback intake disabled until the inbox migration and endpoint are deployed together.
PAWAPAY_CALLBACK_INBOX_ENABLED=false
PAWAPAY_SIGNATURE_KEY_ID=
PAWAPAY_SIGNATURE_PRIVATE_KEY_PATH=./keys/pawapay-signing-private.pem
PAWAPAY_SIGNATURE_PUBLIC_KEY_PATH=./keys/pawapay-signing-public.pem
PAWAPAY_FINAL_STATUS_TIMEOUT_MS=60000
PAWAPAY_FINAL_STATUS_POLL_INTERVAL_MS=5000

# Generate each value with: openssl rand -base64 32. Keep old keys for decrypting snapshots.
EXPENSE_WARRIOR_PAYOUT_DESTINATION_KEYS_JSON=
EXPENSE_WARRIOR_PAYOUT_DESTINATION_ACTIVE_KEY_ID=
