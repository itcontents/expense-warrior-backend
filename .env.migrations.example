# Copy to .env.migrations and keep the migration identity and exact target tuple here.
# The file is local-only and loaded only by the explicit migration operator command.
# Database name is the Expense Warrior database only; never use an ITC database target.
DB_MIGRATION_TARGET=
DB_MIGRATION_ALLOWED_TARGETS=
# Required when the allowlist has more than one name. Map every name to its exact connection tuple.
DB_MIGRATION_TARGETS_JSON=
DB_MIGRATION_TARGET_HOST=
DB_MIGRATION_TARGET_PORT=
DB_MIGRATION_TARGET_DATABASE=
DB_MIGRATION_USER=
DB_MIGRATION_PASSWORD=
